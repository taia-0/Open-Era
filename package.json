{
  "name": "open-era",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A persistent maritime political sandbox simulation.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "simulate": "node --experimental-strip-types src/cli/run-simulation.ts",
    "dashboard": "node --experimental-strip-types src/cli/run-dashboard.ts",
    "dynamism": "node --experimental-strip-types src/cli/dynamism-readout.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --experimental-strip-types --test tests/*.test.ts",
    "golden:update": "node --experimental-strip-types scripts/update-golden-hashes.ts",
    "golden:check": "node --experimental-strip-types --test tests/golden.test.ts",
    "action-picker": "node --experimental-strip-types src/cli/run-action-picker.ts",
    "picker-gate": "node --experimental-strip-types src/cli/picker-gate.ts",
    "ai-pilot": "node --experimental-strip-types src/cli/run-ai-pilot.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.9.3"
  }
}
