+// LIFECYCLE prototype sweep: 13 seeds × 1,200 ticks, main defaults, lifecycle off vs on. Offline, no AI.
+import { runTick } from "../../src/sim/engine.ts";
+import { createPrototypeWorld } from "../../src/sim/scenario.ts";
+import { stateHash } from "../../src/sim/state.ts";
+import { replayWithSilentStarts } from "../../src/sim/tick-start.ts";
+import { dynamismReadout } from "../../src/tools/dynamism.ts";
+import type { SimEvent } from "../../src/sim/types.ts";
+const RA = Number(process.env.LC_RETIRE ?? 215);
+const seeds = [1847, 2718, 4096, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000];
+const PINS: Record<number, string> = { 1847: "94de9c02", 2718: "7a3741c9", 4096: "af6eeaea" };
+function run(seed: number, on: boolean) {
+  const w = createPrototypeWorld(seed); const events: SimEvent[] = []; const viol: string[] = []; const cast: number[] = [];
+  for (let i = 0; i < 1200; i++) {
+    const before = structuredClone(Object.fromEntries(Object.entries(w.characters).map(([k, c]) => [k, { troops: c.troops.count, lc: (c as any).lifecycle, faction: c.factionId }])));
