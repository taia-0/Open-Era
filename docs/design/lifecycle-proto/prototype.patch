+        if (before[d.character.id]) viol.push(`promo id reused t${e.tick}`);
+        if (d.split !== Math.floor((d.split + d.captainTroopsAfter) / 2) || d.split + d.captainTroopsAfter < 424) viol.push(`promo troops t${e.tick}`);
+        if (b?.lc?.lastPromotionTick !== undefined && e.tick - b.lc.lastPromotionTick < 240) viol.push(`promo cooldown t${e.tick}`);
+        if (w.characters[d.character.id]?.factionId !== b?.faction) viol.push(`promo faction t${e.tick}`);
+      }
+      if (e.type === "character-retired") { if (!d.cause || b?.lc?.retired || d.troops >= 25 || e.tick - d.watchSince < RA) viol.push(`retire invalid t${e.tick}`); }
