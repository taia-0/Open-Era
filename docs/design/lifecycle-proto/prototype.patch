+    }
+    if (on) for (const c of Object.values(w.characters)) { const l = (c as any).lifecycle; if (!c.dead && c.controller.kind !== "human" && l?.watchSince !== undefined && !l.retired && w.tick - l.watchSince > RA + 1 && !c.captivity && !c.travel && c.locationId && c.troops.count < 25) viol.push(`missed retirement ${c.id} t${w.tick}`); }
+    if (i % 300 === 0 || i === 1199) cast.push(Object.values(w.characters).filter((c) => !c.dead && !(c as any).lifecycle?.retired).length);
+  }
+  let replayOk = true;
+  if (on) { const r = createPrototypeWorld(seed); replayWithSilentStarts(r, events); replayOk = stateHash(r) === stateHash(w); }
+  const t = dynamismReadout(events).totals;
+  const ports = (f: string) => Object.values(w.settlements).filter((s) => s.factionId === f).length;
+  const members = (f: string) => Object.values(w.characters).filter((c) => !c.dead && c.factionId === f).length;
+  const n = (ty: string) => events.filter((e) => e.type === ty).length;
+  const rc: Record<string, number> = {}; for (const e of events) if (e.type === "character-returned") { const k = String(e.data.cause).split(":")[0]; rc[k] = (rc[k] ?? 0) + 1; }
+  return { seed, on, hash: stateHash(w).slice(0, 8), claims: n("settlement-claimed"), portChanges: t.portOwnershipChanges, secessions: t.secessions, promotions: n("character-promoted"), retirements: n("character-retired"), returns: n("character-returned"), returnCauses: rc, cast, retiredAtEnd: Object.values(w.characters).filter((c) => !c.dead && (c as any).lifecycle?.retired).length, wipeouts: ["world-government", "free-tide"].filter((f) => ports(f) === 0 && members(f) === 0), viol, replayOk };
+}
+const off = seeds.map((s) => run(s, false)); const on = seeds.map((s) => run(s, true));
+console.log("| Seed | Off hash | Promotions | Retirements | Returns (causes) | Retired at t1200 | Active cast t0/300/600/900/1199 | Claims off/on | Port changes off/on | Secessions off/on | Violations | Replay |");
+for (const s of seeds) { const a = off.find((r) => r.seed === s)!, b = on.find((r) => r.seed === s)!; console.log(`| ${s} | ${a.hash}${PINS[s] ? (a.hash === PINS[s] ? " pin" : " MISMATCH") : ""} | ${b.promotions} | ${b.retirements} | ${b.returns} ${JSON.stringify(b.returnCauses)} | ${b.retiredAtEnd} | ${b.cast.join("/")} (off ${a.cast.join("/")}) | ${a.claims} / ${b.claims} | ${a.portChanges} / ${b.portChanges} | ${a.secessions} / ${b.secessions} | ${b.viol.length} | ${b.replayOk ? "exact" : "MISMATCH"} |`); }
+const sum = (rs: typeof on, k: "claims" | "portChanges" | "secessions" | "promotions" | "retirements" | "returns") => rs.reduce((x, r) => x + r[k], 0);
+console.log(JSON.stringify({ claims: [sum(off, "claims"), sum(on, "claims")], portChanges: [sum(off, "portChanges"), sum(on, "portChanges")], secessions: [sum(off, "secessions"), sum(on, "secessions")], promotions: sum(on, "promotions"), retirements: sum(on, "retirements"), returns: sum(on, "returns"), minClaims: Math.min(...on.map((r) => r.claims)), minPortChanges: Math.min(...on.map((r) => r.portChanges)), seedsWithSecession: on.filter((r) => r.secessions > 0).length, newWipeouts: on.filter((r) => r.wipeouts.some((f) => !off.find((o) => o.seed === r.seed)!.wipeouts.includes(f))).map((r) => r.seed), replayAll: on.every((r) => r.replayOk), violations: on.flatMap((r) => r.viol).slice(0, 8), violationCount: on.reduce((x, r) => x + r.viol.length, 0) }));
