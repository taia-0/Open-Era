+// Flag-off distributions for LIFECYCLE thresholds. 13 seeds x 1,200 ticks, main defaults.
+import { runTick } from "../../src/sim/engine.ts";
+import { createPrototypeWorld } from "../../src/sim/scenario.ts";
+const seeds = [1847, 2718, 4096, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000];
+const spells: number[] = []; const open: number[] = []; const winTroops: number[] = []; let castMax = 0;
+for (const seed of seeds) {
+  const w = createPrototypeWorld(seed); const since: Record<string, number> = {};
+  for (let i = 0; i < 1200; i++) {
+    const evs = runTick(w).events;
+    for (const e of evs) if (e.type === "battle-resolved" && e.data.outcome === "attacker-victory" && e.actorId) { const c = w.characters[e.actorId]; if (c && !c.dead) winTroops.push(c.troops.count); }
+    for (const c of Object.values(w.characters)) {
+      if (c.dead || c.controller.kind === "human") { if (since[c.id] !== undefined) { spells.push(w.tick - since[c.id]); delete since[c.id]; } continue; }
+      const below = c.troops.count < 25;
+      if (below && since[c.id] === undefined) since[c.id] = w.tick;
+      else if (!below && since[c.id] !== undefined) { spells.push(w.tick - since[c.id]); delete since[c.id]; }
+    }
+    castMax = Math.max(castMax, Object.values(w.characters).filter((c) => !c.dead).length);
+  }
+  for (const k of Object.keys(since)) open.push(w.tick - since[k]);
+}
