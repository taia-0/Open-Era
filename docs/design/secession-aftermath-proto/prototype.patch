+// Flag-off: hold times of seceded ports, raids by old faction, nearby third factions. 13 seeds x 1,200, main defaults.
+import { runTick } from "../../src/sim/engine.ts";
+import { createPrototypeWorld } from "../../src/sim/scenario.ts";
+const seeds = [1847, 2718, 4096, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000];
+const out: any[] = [];
+for (const seed of (process.argv[2] ? [Number(process.argv[2])] : seeds)) {
+  const w = createPrototypeWorld(seed); const open: Record<string, any> = {};
+  for (let i = 0; i < 1200; i++) {
+    const evs = runTick(w).events;
+    for (const e of evs) {
+      if (e.type === "secession-declared") open[(e.data as any).faction.id] = { seed, port: e.settlementId, fid: (e.data as any).faction.id, old: (e.data as any).previousFactionId, t0: e.tick, raids: [] as number[], treasury0: (e.data as any).faction.treasury };
+      if (e.type === "battle-started" || (e.type === "battle-resolved" && !e.data.battleId)) { const atk = e.actorId ? w.characters[e.actorId]?.factionId : null; for (const r of Object.values(open)) if (r.end === undefined && e.settlementId === r.port && e.targetId === r.fid) { r.raids.push(e.tick - r.t0); if (atk === r.old) r.oldRaids = (r.oldRaids ?? []).concat(e.tick - r.t0); } }
+    }
+    for (const r of Object.values(open)) if (r.end === undefined && w.settlements[r.port].factionId !== r.fid) { r.end = w.tick - r.t0; r.to = w.settlements[r.port].factionId; }
+  }
+  for (const r of Object.values(open)) { if (r.end === undefined) { r.censored = 1200 - r.t0; r.treasuryEnd = w.factions[r.fid].treasury; } out.push(r); }
+}
+console.log(JSON.stringify(out));
