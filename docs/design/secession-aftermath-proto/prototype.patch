+import { runTick } from "../../src/sim/engine.ts";
+import { createPrototypeWorld } from "../../src/sim/scenario.ts";
+import { stateHash } from "../../src/sim/state.ts";
+import { replayWithSilentStarts } from "../../src/sim/tick-start.ts";
+import { dynamismReadout } from "../../src/tools/dynamism.ts";
+import { atPeace, AFTERMATH_WINDOW, PEACE_GRIEVANCE } from "../../src/sim/secession-aftermath.ts";
+import { allied, ALLIANCE_NEAR } from "../../src/sim/alliances.ts";
+import type { SimEvent } from "../../src/sim/types.ts";
+const seed = Number(process.argv[2]); const extra = process.argv[3] === "all" ? { occupation: true, alliances: true, portTransfer: true, lifecycle: true } : {};
+const PINS: Record<number, string> = { 1847: "94de9c02", 2718: "7a3741c9", 4096: "af6eeaea" };
+const dist = (w: any, a: string, b: string) => { const p = w.settlements[a].position, q = w.settlements[b].position; return Math.hypot(p.x - q.x, p.y - q.y); };
+function run(on: boolean) {
+  const w = createPrototypeWorld(seed); const events: SimEvent[] = []; const viol: string[] = []; const holds: number[] = []; const peaceAfter: { pair: string[]; tick: number }[] = [];
+  for (let i = 0; i < 1200; i++) {
+    const evs = runTick(w, { ...extra, secessionAftermath: on } as never).events; events.push(...evs);
+    for (const e of evs) {
+      const d = e.data as any;
+      if (e.type === "battle-started" || (e.type === "battle-resolved" && !d.battleId)) { const a = e.actorId ? w.characters[e.actorId]?.factionId : null; for (const p of peaceAfter) if (e.tick > p.tick && p.pair.includes(a!) && p.pair.includes(e.targetId!)) viol.push(`raid across peace ${p.pair} t${e.tick}`); }
+      if (e.type === "faction-peace") { const ids = d.peace.factionIds; if (!d.peace.cause || ids.length !== 2 || d.age < AFTERMATH_WINDOW || d.grievance >= PEACE_GRIEVANCE) viol.push(`peace invalid t${e.tick}`); peaceAfter.push({ pair: ids, tick: e.tick }); holds.push(d.age);
+        for (const f of Object.keys(w.factions)) if (!ids.includes(f) && (atPeace(w, ids[0], f) && !peaceAfter.some((p) => p.pair.includes(ids[0]) && p.pair.includes(f)))) viol.push(`peace not bilateral t${e.tick}`); }
+      if (e.type === "alliance-formed" && d.aftermath === "protection") { const [x, y] = d.alliance.factionIds; const r = (w as any).secessionAftermath.records.find((q: any) => q.factionId === x); if (!r || y === r.oldFactionId || !d.alliance.causes[x] || !d.alliance.causes[y] || e.tick - r.declaredTick < AFTERMATH_WINDOW) viol.push(`protection invalid t${e.tick}`); holds.push(e.tick - r.declaredTick); }
+      if (e.type === "secession-joined") { const to = d.joinedFactionId; const r = (w as any).secessionAftermath.records.find((q: any) => q.factionId === d.factionId);
+        const near = Object.values(w.settlements).some((s) => s.factionId === to && !d.ports.includes(s.id) && dist(w, s.id, e.settlementId!) <= ALLIANCE_NEAR);
+        if (!d.cause || to === d.oldFactionId || !near || allied(w, to, d.oldFactionId) || atPeace(w, to, d.oldFactionId) || d.memberIds.some((m: string) => w.characters[m].factionId !== to) || w.settlements[e.settlementId!].factionId !== to || e.tick - r.declaredTick < AFTERMATH_WINDOW) viol.push(`join invalid t${e.tick}`); holds.push(e.tick - r.declaredTick); }
+    }
+  }
+  let replayOk = true; if (on) { const r = createPrototypeWorld(seed); replayWithSilentStarts(r, events); replayOk = stateHash(r) === stateHash(w); }
+  const t = dynamismReadout(events).totals; const n = (ty: string) => events.filter((e) => e.type === ty).length;
+  const ports = (f: string) => Object.values(w.settlements).filter((s) => s.factionId === f).length; const members = (f: string) => Object.values(w.characters).filter((c) => !c.dead && c.factionId === f).length;
+  return { seed, on, hash: stateHash(w).slice(0, 8), claims: n("settlement-claimed"), portChanges: t.portOwnershipChanges + n("secession-joined"), joinsPortChanges: n("secession-joined"), secessions: t.secessions, battles: n("battle-resolved"), peace: n("faction-peace"), protection: events.filter((e) => e.type === "alliance-formed" && e.data.aftermath === "protection").length, joins: n("secession-joined"), protectionBroken: events.filter((e) => e.type === "alliance-broken" && String(e.data.allianceId).startsWith("protection-")).length, holds, wipeouts: ["world-government", "free-tide"].filter((f) => ports(f) === 0 && members(f) === 0), viol, replayOk, pin: PINS[seed] ?? null };
+}
+console.log(JSON.stringify([run(false), run(true)]));
