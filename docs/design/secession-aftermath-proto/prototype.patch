index 0000000..c8eab9a
--- /dev/null
+++ b/src/sim/secession-aftermath.ts
@@ -0,0 +1,95 @@
+import type { SimEvent, WorldState } from "./types.ts";
+import { allied, ALLIANCE_NEAR, ALLIANCE_RAID_WINDOW } from "./alliances.ts";
+import { RESERVE_PER_HEAD } from "./port-transfer.ts";
+import { freeMateCount } from "./allowance.ts";
+import { commandHolderId } from "./state.ts";
+import { startingGrievance } from "./secession.ts";
+/**
+ * SECESSION_AFTERMATH prototype (docs/design/secession-aftermath.md v1): peace, protection, membership.
+ * Deterministic: no RNG, no AI. Flag off: nothing runs; world.secessionAftermath never exists.
+ */
+export const SECESSION_AFTERMATH_DEFAULT = false;
+/** Survival window: median hold of a seceded port, flag off, 13 seeds (31 secessions, all lost; p50 22). */
+export const AFTERMATH_WINDOW = Number(process.env.SA_WINDOW ?? 22);
+/** Peace is blocked by the secession "hated" gate: earned grievance at the old holder ≥ 0.12 (secession.ts). */
+export const PEACE_GRIEVANCE = 0.12;
+export interface AftermathRecord { factionId: string; settlementId: string; oldFactionId: string; ownerId: string; declaredTick: number; peaceTick?: number; protectionTick?: number; joinedTick?: number }
+export interface Peace { factionIds: [string, string]; tick: number; cause: string }
+interface State { records: AftermathRecord[]; peace: Peace[] }
+type W = WorldState & { secessionAftermath?: State; allianceRaids?: Record<string, number> };
+type Emit = (d: { type: string; actorId?: string; settlementId?: string; targetId?: string; data: Record<string, unknown> }) => void;
+const st = (w: WorldState) => (w as W).secessionAftermath;
+export function atPeace(world: WorldState, a: string | null | undefined, b: string | null | undefined): boolean {
+  if (!a || !b || a === b) return false;
+  return (st(world)?.peace ?? []).some((p) => p.factionIds.includes(a) && p.factionIds.includes(b));
+}
+const friendly = (w: WorldState, a: string, b: string) => a === b || atPeace(w, a, b) || allied(w, a, b);
+const ports = (w: WorldState, f: string) => Object.values(w.settlements).filter((s) => s.factionId === f).sort((a, b) => a.id.localeCompare(b.id));
+const alive = (w: WorldState, f: string) => Object.values(w.characters).some((c) => !c.dead && c.factionId === f);
+const dist = (w: WorldState, a: string, b: string) => { const p = w.settlements[a].position, q = w.settlements[b].position; return Math.hypot(p.x - q.x, p.y - q.y); };
+const r2 = (v: number) => Math.round(v * 100) / 100;
+export const surplus = (w: WorldState, f: string) => r2(w.factions[f].treasury - RESERVE_PER_HEAD * (freeMateCount(w, f) + ports(w, f).length));
+export function earnedGrievance(w: WorldState, ownerId: string, oldFactionId: string): number {
+  const holder = commandHolderId(w, oldFactionId); if (!holder) return 0;
+  const owner = w.characters[ownerId]; return r2(((owner?.relationships[holder]?.grievance ?? 0) - startingGrievance(w.seed, ownerId, holder)) * 1000) / 1000;
+}
+/** The threat to a seceded port: the latest hostile raider within the raid window, else the hostile holder of the nearest port within ALLIANCE_NEAR. */
+export function threatTo(w: WorldState, f: string, port: string): { factionId: string; cause: string } | null {
+  const raids = Object.entries((w as W).allianceRaids ?? {}).filter(([k, t]) => k.endsWith(`>${f}`) && w.tick - t <= ALLIANCE_RAID_WINDOW).map(([k, t]) => ({ by: k.slice(0, k.length - f.length - 1), t })).filter((r) => w.factions[r.by] && !friendly(w, r.by, f)).sort((a, b) => b.t - a.t || a.by.localeCompare(b.by));
+  if (raids.length) return { factionId: raids[0].by, cause: `raided: ${raids[0].by} raided ${f} at t${raids[0].t}, ${w.tick - raids[0].t} ticks ago` };
+  const near = Object.values(w.settlements).filter((s) => s.factionId && s.id !== port && !friendly(w, s.factionId, f) && dist(w, s.id, port) <= ALLIANCE_NEAR).sort((a, b) => dist(w, a.id, port) - dist(w, b.id, port) || a.id.localeCompare(b.id));
+  if (near.length) return { factionId: near[0].factionId!, cause: `near: ${near[0].factionId} holds ${near[0].id} at ${dist(w, near[0].id, port).toFixed(3)} from ${port}` };
+  return null;
+}
+/** Candidates for protection or membership: alive, holding a port within ALLIANCE_NEAR, hostile to the old faction, not the threat. Largest surplus first (#182 rule), then id. */
+export function patrons(w: WorldState, r: AftermathRecord, threat: string) {
+  return Object.keys(w.factions).filter((f) => f !== r.factionId && f !== r.oldFactionId && f !== threat && alive(w, f) && !friendly(w, f, r.oldFactionId) && !friendly(w, f, threat))
+    .map((f) => { const p = ports(w, f).find((s) => dist(w, s.id, r.settlementId) <= ALLIANCE_NEAR); return p ? { factionId: f, port: p.id, distance: Number(dist(w, p.id, r.settlementId).toFixed(3)), surplus: surplus(w, f) } : null; })
+    .filter((x): x is NonNullable<typeof x> => x !== null).sort((a, b) => b.surplus - a.surplus || a.factionId.localeCompare(b.factionId));
+}
+export function aftermathStep(world: WorldState, tickEvents: SimEvent[], emit: Emit): void {
+  if (!st(world)) emit({ type: "aftermath-ledger-opened", data: {} });
+  for (const e of tickEvents) if (e.type === "secession-declared") { const d = e.data as any; emit({ type: "aftermath-watch", settlementId: e.settlementId, data: { record: { factionId: d.faction.id, settlementId: e.settlementId, oldFactionId: d.previousFactionId, ownerId: d.ownerId, declaredTick: e.tick } } }); }
+  for (const r of [...(st(world)?.records ?? [])].sort((a, b) => a.declaredTick - b.declaredTick || a.factionId.localeCompare(b.factionId))) {
+    if (r.joinedTick !== undefined) continue;
+    const port = world.settlements[r.settlementId]; const age = world.tick - r.declaredTick;
+    if (port.factionId !== r.factionId || age < AFTERMATH_WINDOW) continue;
+    const held = `${r.factionId} has held ${r.settlementId} ${age} ticks since t${r.declaredTick} (window ${AFTERMATH_WINDOW})`;
+    if (r.peaceTick === undefined && alive(world, r.oldFactionId)) {
+      const g = earnedGrievance(world, r.ownerId, r.oldFactionId); const last = (world as W).allianceRaids?.[`${r.oldFactionId}>${r.factionId}`];
+      const raided = last !== undefined && world.tick - last <= ALLIANCE_RAID_WINDOW;
+      if (g < PEACE_GRIEVANCE && !raided) emit({ type: "faction-peace", settlementId: r.settlementId, data: { peace: { factionIds: [r.factionId, r.oldFactionId], tick: world.tick, cause: `survived: ${held}; earned grievance ${g} < ${PEACE_GRIEVANCE}; no raid by ${r.oldFactionId} within ${ALLIANCE_RAID_WINDOW}` }, grievance: g, lastOldRaid: last ?? null, age } });
+    }
+    if (r.protectionTick !== undefined) continue;
+    if ((world as W).alliances?.some((a) => a.factionIds.includes(r.factionId))) continue;
+    const threat = threatTo(world, r.factionId, r.settlementId); if (!threat) continue;
+    const cands = patrons(world, r, threat.factionId); if (!cands.length) continue;
+    const p = cands[0]; const own = surplus(world, r.factionId);
+    if (own >= 0) emit({ type: "alliance-formed", settlementId: r.settlementId, data: { aftermath: "protection", alliance: { id: `protection-${world.tick}-${r.factionId}-${p.factionId}`, factionIds: [r.factionId, p.factionId], enemyFactionId: threat.factionId, formedTick: world.tick, causes: { [r.factionId]: `protection: ${held}; threat ${threat.cause}; own surplus ${own} >= 0`, [p.factionId]: `protector: holds ${p.port} at ${p.distance}, hostile to ${r.oldFactionId} and ${threat.factionId}, surplus ${p.surplus}` }, portsAtForm: { [r.factionId]: ports(world, r.factionId).length, [p.factionId]: ports(world, p.factionId).length } } } });
+    else {
+      const members = Object.values(world.characters).filter((c) => !c.dead && c.factionId === r.factionId).map((c) => c.id).sort();
+      emit({ type: "secession-joined", settlementId: r.settlementId, actorId: r.ownerId, targetId: p.factionId, data: { factionId: r.factionId, joinedFactionId: p.factionId, oldFactionId: r.oldFactionId, memberIds: members, ports: ports(world, r.factionId).map((s) => s.id), treasury: world.factions[r.factionId].treasury, cause: `membership: ${held}; threat ${threat.cause}; own surplus ${own} < 0; ${p.factionId} holds ${p.port} at ${p.distance}, hostile to ${r.oldFactionId}, surplus ${p.surplus}` } });
+    }
+  }
+}
+export function applyAftermathEvent(world: WorldState, event: SimEvent): boolean {
+  const w = world as W;
+  switch (event.type) {
+    case "aftermath-ledger-opened": w.secessionAftermath = { records: [], peace: [] }; return true;
+    case "aftermath-watch": w.secessionAftermath!.records.push(event.data.record as AftermathRecord); return true;
+    case "faction-peace": { const p = event.data.peace as Peace; w.secessionAftermath!.peace.push(p); const r = w.secessionAftermath!.records.find((x) => x.factionId === p.factionIds[0]); if (r) r.peaceTick = event.tick; return true; }
+    case "secession-joined": {
+      const d = event.data as any; const to = d.joinedFactionId as string;
+      for (const id of d.memberIds as string[]) world.characters[id].factionId = to;
+      for (const s of d.ports as string[]) { world.settlements[s].factionId = to; delete world.settlements[s].occupation; }
+      world.factions[to].treasury = r2(world.factions[to].treasury + world.factions[d.factionId].treasury); world.factions[d.factionId].treasury = 0;
+      const r = w.secessionAftermath!.records.find((x) => x.factionId === d.factionId); if (r) r.joinedTick = event.tick; return true;
+    }
+  }
+  return false;
+}
+/** Protection pacts are alliance records; mark the aftermath record when one forms for a seceded faction. */
+export function noteProtection(world: WorldState, event: SimEvent): void {
+  if (event.type !== "alliance-formed" || event.data.aftermath !== "protection") return;
+  const ids = (event.data.alliance as { factionIds: string[] }).factionIds; const r = st(world)?.records.find((x) => x.factionId === ids[0]); if (r) r.protectionTick = event.tick;
+}
