--- /dev/null
+++ b/tests/relationship-feed-privacy.test.ts
@@ -0,0 +1,25 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { runTick } from "../src/sim/engine.ts";
+import { createPrototypeWorld } from "../src/sim/scenario.ts";
+import type { SimEvent } from "../src/sim/types.ts";
+import { projectEventFeed } from "../src/dashboard/view-model.ts";
+
+// directed-relationships.md rev 2, ruling 4: a relationship-changed row reaches only the character whose relationship
+// changed and that character's own faction. Unconditional (no sim flag); flags at defaults here.
+test("relationship rows are visible only to the character's own faction", () => {
+  const world = createPrototypeWorld(1847);
+  const events: SimEvent[] = [];
+  for (let i = 0; i < 60 && !events.some((e) => e.type === "relationship-changed"); i += 1) events.push(...runTick(world).events);
+  const rel = events.filter((e) => e.type === "relationship-changed");
+  assert.ok(rel.length > 0);
+  const actor = world.characters[rel[0].actorId!];
+  const mine = rel.filter((e) => world.characters[e.actorId!]?.factionId === actor.factionId || e.actorId === actor.id);
+  const own = projectEventFeed(world, actor.id, rel).filter((row) => row.type === "relationship-changed");
+  assert.equal(own.length, mine.length);
+  const outsider = Object.values(world.characters).find((c) => !c.dead && c.factionId && c.factionId !== actor.factionId)!;
+  const theirs = rel.filter((e) => world.characters[e.actorId!]?.factionId === outsider.factionId);
+  const seen = projectEventFeed(world, outsider.id, rel).filter((row) => row.type === "relationship-changed");
+  assert.equal(seen.length, theirs.length);
+  for (const row of seen) assert.equal(world.characters[row.actorId as string].factionId, outsider.factionId);
+});
