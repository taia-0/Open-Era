new file mode 100644
index 0000000..1f72723
--- /dev/null
+++ b/src/sim/relationships.ts
@@ -0,0 +1,132 @@
+import { clamp, commandHolderId, round } from "./state.ts";
+import type { Relationship, SimEvent, WorldState } from "./types.ts";
+
+/**
+ * DIRECTED RELATIONSHIPS (docs/design/directed-relationships.md, prototype). Two flags, both default off; off is byte-identical.
+ *  - `relationships` (R): a faction → faction harm ledger, `world.harm`, keyed `by>on`, derived in the reducer from
+ *    existing events (raid, capture, claim). Read by alliance partner order (rev 2: the NT receiver reader is dropped).
+ *  - `relationshipsChar` (R-char): personal grievance in `Character.relationships`, written in the reducer from the
+ *    events where people wrong each other (raided, captured, ransomed) and, with negotiated transfer, a lost seat.
+ *    Rev 2: the raided side (defending holder and commander) grudges the raider; the raider gains nothing.
+ * Deterministic: no RNG, no AI. Every write is a fold of a recorded event, so replay is exact.
+ */
+export const RELATIONSHIPS_DEFAULT = false;
+export const RELATIONSHIPS_CHAR_DEFAULT = false;
+/** The harm window: ALLIANCE_RAID_WINDOW, the measured p90 gap between raids by one faction on another (152; alliances.ts). */
+export const HARM_WINDOW = 152; // === alliances.ts ALLIANCE_RAID_WINDOW (a literal: the two modules import each other)
+/**
+ * One wrong's grievance step: the codebase's existing per-incident grievance delta for being wronged, `DEFEAT.grievance`
+ * in contracts.ts (a breached contract) and the costly-defeat-under-orders write in engine.ts recordBattleConsequences. Not tuned.
+ */
+export const GRUDGE_STEP = 0.035;
+/**
+ * A tie a grudge creates. Rev 2 (no double penalty): trust and respect start at the contract score's missing-tie defaults
+ * (contracts.ts SCORE_TRUST / SCORE_RESPECT 0.35, the same as agency.ts assessStandingOrder), so creating the tie moves
+ * no score; obligation 0 is also the score's missing default. Affinity and fear are RELATIONSHIP_BASE (contracts.ts);
+ * no reader gives them a missing-tie default. Only grievance moves.
+ */
+export const NEW_TIE_TRUST = 0.35; // === contracts.ts SCORE_TRUST (a literal: importing contracts.ts here reorders module init)
+export const NEW_TIE_RESPECT = 0.35; // === contracts.ts SCORE_RESPECT
+const newTie = (toId: string, tick: number): Relationship =>
+  ({ characterId: toId, trust: NEW_TIE_TRUST, affinity: 0.25, respect: NEW_TIE_RESPECT, fear: 0.08, grievance: 0, obligation: 0, lastChangedTick: tick });
+
+export type HarmKind = "raid" | "capture" | "claim";
+export interface HarmPair { recent: Array<{ tick: number; kind: HarmKind }>; total: number; lastTick: number }
+export type HarmLedger = Record<string, HarmPair>;
+type W = WorldState & { harm?: HarmLedger; grudges?: true };
+
+export const harmLedger = (world: WorldState) => (world as W).harm;
+export const grudgesOn = (world: WorldState) => (world as W).grudges === true;
+
+/** Harm by `by` on `on` inside the window ending at `tick` (inclusive, `tick - t <= 152`, the allianceCause test). */
+export function harmCount(world: WorldState, by: string, on: string, tick = world.tick): number {
+  const p = harmLedger(world)?.[`${by}>${on}`];
+  return p ? p.recent.filter((e) => tick - e.tick <= HARM_WINDOW).length : 0;
+}
+export const mutualHarm = (world: WorldState, a: string, b: string) => harmCount(world, a, b) + harmCount(world, b, a);
+
+/** Openers. Returns true when the event was a relationships bookkeeping event. */
+export function applyRelationshipsEvent(world: WorldState, event: SimEvent): boolean {
+  const w = world as W;
+  if (event.type === "harm-ledger-opened") { w.harm = {}; return true; }
+  if (event.type === "grudge-ledger-opened") { w.grudges = true; return true; }
+  return false;
+}
+
+function addHarm(world: WorldState, by: string, on: string, kind: HarmKind, tick: number): void {
+  const l = harmLedger(world); if (!l || by === on) return;
+  const key = `${by}>${on}`;
+  const p = l[key] ?? { recent: [], total: 0, lastTick: tick };
+  p.recent = [...p.recent.filter((e) => tick - e.tick <= HARM_WINDOW), { tick, kind }];
+  p.total += 1; p.lastTick = tick;
+  l[key] = p;
+}
+
+/** The relationship after one grudge step (for a writer that emits `relationship-changed`). Only grievance changes. */
+export function grudgeRelationship(world: WorldState, fromId: string, toId: string, tick: number): Relationship {
+  const prior: Relationship = world.characters[fromId].relationships[toId] ?? newTie(toId, tick);
+  return { ...prior, grievance: round(clamp(prior.grievance + GRUDGE_STEP, 0, 1)), lastChangedTick: tick };
+}
+
+/** One grudge step from `fromId` toward `toId` (reducer-derived writers). */
+export function grudge(world: WorldState, fromId: string | null | undefined, toId: string | null | undefined, tick: number, kind: string): void {
+  if (!fromId || !toId || fromId === toId) return;
+  const from = world.characters[fromId]; if (!from || !world.characters[toId]) return;
+  reportReader({ reader: "grudge", kind, fromId, toId, tick, created: !from.relationships[toId] });
+  from.relationships[toId] = grudgeRelationship(world, fromId, toId, tick);
+}
+
+export function noteHarm(world: WorldState, event: SimEvent): void {
+  const ledgerOn = harmLedger(world) !== undefined, charOn = grudgesOn(world);
+  if (!ledgerOn && !charOn) return;
+  if (event.type === "battle-started" || (event.type === "battle-resolved" && !event.data.battleId)) {
+    // The raid test alliances.ts noteRaid uses.
+    const attacker = event.actorId ? world.characters[event.actorId] : undefined;
+    const atk = attacker?.factionId ?? null; const def = event.targetId ?? null;
+    if (!attacker || !atk || !def || atk === def) return;
+    if (ledgerOn) addHarm(world, atk, def, "raid", event.tick);
+    if (charOn) {
+      // Rev 2 ruling 1: the defending holder (the port's owner) and the defending faction's commander each grudge the
+      // raid commander. The raider gains nothing for raiding.
+      const holder = event.settlementId ? world.settlements[event.settlementId]?.ownerId ?? null : null;
+      const commander = commandHolderId(world, def);
+      grudge(world, holder, attacker.id, event.tick, "raid");
+      if (commander !== holder) grudge(world, commander, attacker.id, event.tick, "raid");
+    }
+    return;
+  }
+  if (event.type === "character-captured") {
+    const prisoner = event.actorId ? world.characters[event.actorId] : undefined;
+    const captorF = event.targetId ?? null; const pf = prisoner?.factionId ?? null;
+    if (ledgerOn && captorF && pf && captorF !== pf) addHarm(world, captorF, pf, "capture", event.tick);
+    if (charOn && prisoner) grudge(world, prisoner.id, event.data.captorId as string | undefined, event.tick, "capture");
+    return;
+  }
+  if (event.type === "captivity-released" && charOn) {
+    const terms = event.data.terms as { moneyPaid?: number; debtValue?: number } | undefined;
+    if (!terms || (terms.moneyPaid ?? 0) + (terms.debtValue ?? 0) <= 0) return;
+    const ransom = event.data.ransom as { leaderId?: string } | undefined;
+    const ransomer = ransom?.leaderId ?? (event.targetId ? commandHolderId(world, event.targetId) : null);
+    grudge(world, event.actorId, ransomer, event.tick, "ransom");
+    return;
+  }
+  if (event.type === "settlement-claimed" && ledgerOn) {
+    const by = event.data.factionId as string | null, on = event.data.previousFactionId as string | null;
+    if (by && on && by !== on) addHarm(world, by, on, "claim", event.tick);
+  }
+}
+
+/** Own-faction projection (ruling 5): harm received, by faction, window count, total and last tick. Harm dealt and third-party rows are never returned. */
+export function harmReceivedRows(world: WorldState, factionId: string, tick = world.tick) {
+  const l = harmLedger(world); if (!l) return [];
+  return Object.entries(l)
+    .filter(([k]) => k.endsWith(`>${factionId}`) && k.split(">")[1] === factionId)
+    .map(([k, p]) => ({ factionId: k.split(">")[0], recent: p.recent.filter((e) => tick - e.tick <= HARM_WINDOW).length, total: p.total, lastTick: p.lastTick }))
+    .sort((a, b) => a.factionId.localeCompare(b.factionId));
+}
+
+/** Harness-only diagnostic hook (not state, not an event): readers report each decision so a checker can see whether harm changed it. */
+export function reportReader(d: Record<string, unknown>): void {
+  const h = (globalThis as { __relHook?: (d: Record<string, unknown>) => void }).__relHook;
+  if (h) h(d);
+}
