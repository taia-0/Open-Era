 /** An away port's item counts while the tax tick minus `observedTick` is at most this. */
 export const NEWS_AGE_CAP = 24;
 
+/**
+ * How long a port keeps an item on its ledger: the 180-tick check-in window
+ * (`CHECK_IN_TICKS` in `dashboard/view-model.ts`; a literal here, the sim does
+ * not import the dashboard).
+ */
+export const NEWS_RETENTION_TICKS = 180;
+
+const OWNERSHIP_NEWS_TYPES = new Set(["settlement-claimed", "settlement-purchased", "secession-joined"]);
+
+function newer(left: NewsRecord, right: NewsRecord): boolean {
+  return left.item.observedTick > right.item.observedTick ||
+    (left.item.observedTick === right.item.observedTick && left.sequence > right.sequence);
+}
+
+/**
+ * The ledger after retention. An item stays while it is at most
+ * `NEWS_RETENTION_TICKS` old. An older item stays only when it is the latest of
+ * its kind about a port, because a reader still takes the latest: the latest
+ * claim, purchase, and join (`ownLossCouriers`, `learnedHolder`) and the latest
+ * item that carries an occupation (`snapFromNews`). Order is kept.
+ */
+export function pruneNews(records: readonly NewsRecord[], tick: number): NewsRecord[] {
+  const latest = new Map<string, NewsRecord>();
+  const note = (key: string, record: NewsRecord) => {
+    const held = latest.get(key);
+    if (!held || newer(record, held)) latest.set(key, record);
+  };
+  for (const record of records) {
+    if (!record.aboutSettlementId) continue;
+    if (OWNERSHIP_NEWS_TYPES.has(record.item.type)) note(`${record.aboutSettlementId}|${record.item.type}`, record);
+    if (record.item.occupation) note(`${record.aboutSettlementId}|occupation`, record);
+  }
+  const keep = new Set(latest.values());
+  return records.filter((record) => tick - record.item.observedTick <= NEWS_RETENTION_TICKS || keep.has(record));
+}
+
+/** The arrival guard: would `record` survive on this ledger now? Not posting a record the ledger would drop at once keeps the log as it was. */
+export function newsRetained(ledger: readonly NewsRecord[] | undefined, record: NewsRecord, tick: number): boolean {
+  if (tick - record.item.observedTick <= NEWS_RETENTION_TICKS) return true;
+  return pruneNews([...(ledger ?? []), record], tick).includes(record);
+}
