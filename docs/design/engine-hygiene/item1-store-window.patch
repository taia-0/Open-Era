+/** The seat map as stored beside a snapshot: [settlementId, characterId, factionId], sorted by port. */
+export function exportGovernorSeats(world: WorldState): Array<[string, string, string]> {
+  return [...memory(world).seats.entries()]
+    .sort((left, right) => left[0].localeCompare(right[0]))
+    .map(([settlementId, seat]) => [settlementId, seat.characterId, seat.factionId]);
+}
+
+/** Put a stored seat map on a world restored from its snapshot. The hash does not see it. */
+export function importGovernorSeats(world: WorldState, seats: ReadonlyArray<readonly [string, string, string]>): void {
+  memories.set(world, {
+    seats: new Map(seats.map(([settlementId, characterId, factionId]) => [settlementId, { characterId, factionId }])),
+    levySettlements: null,
+  });
+}
