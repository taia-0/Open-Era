+/** The seat map as stored beside a snapshot: [settlementId, characterId, factionId], sorted by port. */
+export function exportGovernorSeats(world: WorldState): Array<[string, string, string]> {
+  return [...memory(world).seats.entries()]
+    .sort((left, right) => left[0].localeCompare(right[0]))
+    .map(([settlementId, seat]) => [settlementId, seat.characterId, seat.factionId]);
