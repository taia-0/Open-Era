+/**
+ * offices-docked-governor.md: a governor keeps the seat (and the title) while sailing, but is consulted only while
+ * docked at a port they govern: locationId is one of their seats, no travel, no captivity (the secession presence
+ * rule). Away from every seat the decision runs on standing behaviour: the sim's own pick, candidates[0], no consult.
+ */
+export function wgGovernorDocked(world: WorldState, character: Character): boolean {
+  const here = character.locationId;
+  return here !== null && character.travel === null && character.captivity === null && governorId(world, here) === character.id;
+}
