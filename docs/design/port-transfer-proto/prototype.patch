+const seeds = [1847, 2718, 4096, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000];
+const PINS: Record<number, string> = { 1847: "94de9c02", 2718: "7a3741c9", 4096: "af6eeaea" };
+function run(seed: number, on: boolean) {
+  const w = createPrototypeWorld(seed); const events: SimEvent[] = []; const viol: string[] = []; let vcOwnedTicks = 0; const vcOwners = new Set<string>();
+  for (let i = 0; i < 1200; i++) {
+    const vcBefore = w.settlements["verdant-cay"].factionId;
+    const evs = runTick(w, { portTransfer: on } as never).events; events.push(...evs);
+    for (const e of evs) if (e.type === "settlement-purchased") {
+      const d = e.data as Record<string, any>;
+      if (e.tick % 24 !== 0 || e.tick === 0) viol.push(`off-clock t${e.tick}`);
+      if (vcBefore !== null && e.settlementId === "verdant-cay") viol.push(`port not neutral t${e.tick}`);
+      if (!d.payerFactionId || !w.factions[d.payerFactionId]) viol.push(`no payer t${e.tick}`);
+      if (d.price !== 12 * d.priceBasis.garrison || d.price <= 0) viol.push(`price basis t${e.tick}`);
+      if (d.treasuryBefore < d.price + d.reserve) viol.push(`treasury short t${e.tick}`);
+      if (Math.abs(d.treasuryAfter - (d.treasuryBefore - d.price)) > 0.005) viol.push(`payment mismatch t${e.tick}`);
+      if (!d.cause) viol.push(`no cause t${e.tick}`);
+      if (w.characters[d.ownerId]?.factionId !== d.factionId) viol.push(`agent not of buyer t${e.tick}`);
+    }
+    const f = w.settlements["verdant-cay"].factionId; if (f) { vcOwnedTicks++; vcOwners.add(f.startsWith("secession") ? "secession" : f); }
+  }
+  const t = dynamismReadout(events).totals;
+  const ports = (f: string) => Object.values(w.settlements).filter((s) => s.factionId === f).length;
+  const members = (f: string) => Object.values(w.characters).filter((c) => !c.dead && c.factionId === f).length;
+  const buys = events.filter((e) => e.type === "settlement-purchased");
+  const causes: Record<string, number> = {}; const buyers: Record<string, number> = {}; for (const b of buys) { const k = String(b.data.cause).split(":")[0]; causes[k] = (causes[k] ?? 0) + 1; const f = String(b.data.factionId); const fk = f.startsWith("secession") ? "secession" : f; buyers[fk] = (buyers[fk] ?? 0) + 1; }
+  return { seed, on, hash: stateHash(w).slice(0, 8), claims: events.filter((e) => e.type === "settlement-claimed").length, portChanges: t.portOwnershipChanges, secessions: t.secessions,
+    vcBattles: events.filter((e) => e.type === "battle-started" && e.settlementId === "verdant-cay").length, vcClaims: events.filter((e) => e.type === "settlement-claimed" && e.settlementId === "verdant-cay").length,
+    buys: buys.length, firstBuy: buys[0]?.tick ?? null, prices: buys.map((b) => b.data.price as number), causes, buyers, vcOwnedTicks, vcOwners: [...vcOwners], vcEnd: w.settlements["verdant-cay"].factionId, wipeouts: ["world-government", "free-tide"].filter((f) => ports(f) === 0 && members(f) === 0), viol };
+}
+const off = seeds.map((s) => run(s, false)); const on = seeds.map((s) => run(s, true));
+console.log("| Seed | Off hash | Purchases (first tick) | Buyer | Prices | VC owned ticks on | VC owner t1200 | VC battles / claims on | Claims off/on | Port changes off/on | Secessions off/on | Wipeouts on/off | Violations |");
+for (const s of seeds) { const a = off.find((r) => r.seed === s)!, b = on.find((r) => r.seed === s)!; console.log(`| ${s} | ${a.hash}${PINS[s] ? (a.hash === PINS[s] ? " pin" : " MISMATCH") : ""} | ${b.buys} (${b.firstBuy}) | ${JSON.stringify(b.buyers)} | ${b.prices.join(", ")} | ${b.vcOwnedTicks} | ${b.vcEnd ?? "neutral"} | ${b.vcBattles} / ${b.vcClaims} | ${a.claims} / ${b.claims} | ${a.portChanges} / ${b.portChanges} | ${a.secessions} / ${b.secessions} | ${JSON.stringify(b.wipeouts)} / ${JSON.stringify(a.wipeouts)} | ${b.viol.length} |`); }
+const sum = (rs: typeof on, k: "claims" | "portChanges" | "secessions" | "buys" | "vcBattles" | "vcClaims") => rs.reduce((x, r) => x + r[k], 0);
+const causeTot: Record<string, number> = {}; for (const r of on) for (const [k, v] of Object.entries(r.causes)) causeTot[k] = (causeTot[k] ?? 0) + v;
+console.log(JSON.stringify({ claims: [sum(off, "claims"), sum(on, "claims")], portChanges: [sum(off, "portChanges"), sum(on, "portChanges")], secessions: [sum(off, "secessions"), sum(on, "secessions")], purchases: sum(on, "buys"), seedsWithPurchase: on.filter((r) => r.buys).length, causeTot, vcBattlesOn: sum(on, "vcBattles"), vcClaimsOn: sum(on, "vcClaims"), vcBattlesOff: sum(off, "vcBattles"),
+  minClaims: Math.min(...on.map((r) => r.claims)), minPortChanges: Math.min(...on.map((r) => r.portChanges)), seedsWithSecession: on.filter((r) => r.secessions > 0).length,
+  newWipeouts: on.filter((r) => r.wipeouts.some((f) => !off.find((o) => o.seed === r.seed)!.wipeouts.includes(f))).map((r) => r.seed), violations: on.flatMap((r) => r.viol).slice(0, 10) }));
