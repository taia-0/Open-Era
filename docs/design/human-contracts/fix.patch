+export const HUMAN_CONTRACTS_DEFAULT = false;
+export const HUMAN_OFFER_WINDOW_TICKS = 180;
+
+/**
+ * The delivery deadline a human carrier gets if they answer yes now: the NPC
+ * formula (`offerAutonomousSupply`), applied at the moment of acceptance.
+ */
+export function humanAcceptTerms(world: WorldState, carrier: Character, contract: SupplyContract) {
+  const travelTicks = contractTravelTicks(world, carrier, contract.destinationId);
+  const deadlineTick = world.tick + Math.min(SUPPLY_DEADLINE_CAP, Math.max(travelTicks + 1, 2));
+  const assessment = assessSupplyContract(world, carrier, {
+    buyerId: contract.buyerId,
+    quantity: contract.quantity,
+    price: contract.price,
+    destinationId: contract.destinationId,
+    deadlineTick,
+  });
+  return { deadlineTick, assessment };
+}
