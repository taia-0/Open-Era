+/**
+ * HUMAN_CONTRACTS: the human carrier answers an offer a buyer made to them.
+ * A world without the flag has no contract whose carrier is human, so both
+ * verbs refuse with `not-carrier` there and need no flag check.
+ */
+function validateAnswerContract(
+  world: WorldState,
+  request: Extract<CommandRequest, { type: "accept-contract" | "decline-contract" }>,
+): CommandSubmission {
+  const player = world.players[request.playerId];
+  const carrier = world.characters[player.characterId];
+  const contract = typeof request.contractId === "string" ? world.contracts?.[request.contractId] : undefined;
+  if (!contract) return reject("unknown-contract", "That contract does not exist");
+  if (contract.carrierId !== carrier.id) return reject("not-carrier", "Only the character the contract was offered to may answer it");
+  if (contract.status !== "offered" || contract.settled) return reject("contract-not-open", "That contract is already closed");
+  if (contract.offerExpiresTick === undefined) return reject("not-carrier", "Only the character the contract was offered to may answer it");
+  if (world.tick >= contract.offerExpiresTick) return reject("offer-expired", "The offer has lapsed");
+  if (contractMutationPending(world, contract.id)) {
+    return reject("contract-already-queued", "Another command already queued will act on that contract");
+  }
+  if (request.type === "accept-contract") {
+    if (carrier.travel || !carrier.locationId) return reject("carrier-traveling", "The carrier is at sea");
+    const terms = humanAcceptTerms(world, carrier, contract);
+    if (terms.assessment.gate === "travel") return reject("voyage-too-long", terms.assessment.reason ?? "The voyage does not fit the deadline.");
+    if (terms.assessment.gate === "purse") return reject("insufficient-money", "The purse cannot cover the cargo shortfall");
+  }
+  const command: PlayerCommand = {
+    id: `command-${String(world.nextCommandSequence).padStart(5, "0")}`,
+    playerId: player.id,
+    issuedTick: world.tick,
+    type: request.type,
+    contractId: contract.id,
+  };
+  return { ok: true, command, event: acceptedEvent(world, command) };
+}
