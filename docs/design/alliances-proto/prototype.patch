+// ALLIANCES prototype sweep: 13 seeds × 1,200 ticks, defaults (exile on), alliances off vs on. Offline, no AI.
+import { runTick } from "../../src/sim/engine.ts";
+import { alliancesOf, allied } from "../../src/sim/alliances.ts";
+import { createPrototypeWorld } from "../../src/sim/scenario.ts";
+import { stateHash } from "../../src/sim/state.ts";
+import { dynamismReadout } from "../../src/tools/dynamism.ts";
+import type { SimEvent } from "../../src/sim/types.ts";
+const seeds = [1847, 2718, 4096, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000];
+const PINS: Record<number, string> = { 1847: "94de9c02", 2718: "7a3741c9", 4096: "af6eeaea" };
+function run(seed: number, on: boolean) {
+  const w = createPrototypeWorld(seed); const events: SimEvent[] = []; const viol: string[] = [];
+  for (let i = 0; i < 1200; i++) {
+    const before = alliancesOf(w).map((a) => ({ ...a }));
+    const evs = runTick(w, { alliances: on } as never).events; events.push(...evs);
+    for (const e of evs) {
+      if (e.type === "alliance-formed") { const a = e.data.alliance as { causes: Record<string, string>; factionIds: string[] }; if (a.factionIds.some((f) => !a.causes[f])) viol.push(`form without cause t${e.tick}`); }
+      if (e.type === "alliance-broken") {
+        const r = e.data.reason as string; const ids = e.data.factionIds as string[]; const en = e.data.enemyFactionId as string;
+        const enemyPorts = Object.values(w.settlements).filter((s) => s.factionId === en).length;
+        const gone = ids.some((f) => !Object.values(w.characters).some((c) => !c.dead && c.factionId === f));
+        const ok = r === "enemy-portless" ? enemyPorts === 0 : r === "ally-gone" ? gone : r === "ally-attack" ? Boolean((e.data.evidence as { battleId?: string }).battleId) : false;
+        if (!ok) viol.push(`break ${r} not matching state t${e.tick}`);
+      }
+      if (e.type === "battle-started") { const atk = w.characters[e.actorId!]?.factionId; const def = e.targetId; if (before.some((a) => a.factionIds.includes(atk as string) && a.factionIds.includes(def as string) && atk !== def)) viol.push(`raid on ally started t${e.tick}`); }
+    }
+    for (const a of alliancesOf(w)) { const en = Object.values(w.settlements).filter((s) => s.factionId === a.enemyFactionId).length; if (!en) viol.push(`pact alive with portless enemy t${w.tick}`); }
+  }
+  const t = dynamismReadout(events).totals;
+  const ports = (f: string) => Object.values(w.settlements).filter((s) => s.factionId === f).length;
+  const members = (f: string) => Object.values(w.characters).filter((c) => !c.dead && c.factionId === f).length;
+  const forms = events.filter((e) => e.type === "alliance-formed"); const breaks = events.filter((e) => e.type === "alliance-broken");
+  const reasons: Record<string, number> = {}; for (const b of breaks) reasons[b.data.reason as string] = (reasons[b.data.reason as string] ?? 0) + 1;
+  const causes: Record<string, number> = {}; for (const f of forms) for (const c of Object.values((f.data.alliance as { causes: Record<string, string> }).causes)) { const k = c.split(":")[0]; causes[k] = (causes[k] ?? 0) + 1; }
+  const durations = breaks.map((b) => { const f = forms.find((x) => (x.data.alliance as { id: string }).id === b.data.allianceId); return f ? b.tick - f.tick : null; }).filter((x) => x !== null) as number[];
+  void allied;
+  return { seed, on, hash: stateHash(w).slice(0, 8), events: events.length, claims: t.claims ?? events.filter((e) => e.type === "settlement-claimed").length, portChanges: t.portOwnershipChanges, secessions: t.secessions, battles: events.filter((e) => e.type === "battle-started").length, wipeouts: ["world-government", "free-tide"].filter((f) => ports(f) === 0 && members(f) === 0), forms: forms.length, breaks: breaks.length, reasons, causes, durations, liveAtEnd: alliancesOf(w).length, viol };
+}
+const off = seeds.map((s) => run(s, false)); const on = seeds.map((s) => run(s, true));
+for (const s of seeds) { const a = off.find((r) => r.seed === s)!, b = on.find((r) => r.seed === s)!; console.log(`| ${s} | ${a.hash}${PINS[s] ? (a.hash === PINS[s] ? " (pin)" : " PIN MISMATCH") : ""} | ${b.forms} | ${b.breaks} ${JSON.stringify(b.reasons)} | ${a.claims} / ${b.claims} | ${a.portChanges} / ${b.portChanges} | ${a.battles} / ${b.battles} | ${a.secessions} / ${b.secessions} | ${JSON.stringify(b.wipeouts)} vs ${JSON.stringify(a.wipeouts)} | ${b.viol.length} |`); }
+const sum = (rs: typeof on, k: "claims" | "portChanges" | "secessions" | "forms" | "breaks" | "battles") => rs.reduce((x, r) => x + r[k], 0);
+const allDur = on.flatMap((r) => r.durations).sort((a, b) => a - b);
+const causeTot: Record<string, number> = {}; const reasonTot: Record<string, number> = {};
+for (const r of on) { for (const [k, v] of Object.entries(r.causes)) causeTot[k] = (causeTot[k] ?? 0) + v; for (const [k, v] of Object.entries(r.reasons)) reasonTot[k] = (reasonTot[k] ?? 0) + v; }
+console.log(JSON.stringify({ totals: { claims: [sum(off, "claims"), sum(on, "claims")], portChanges: [sum(off, "portChanges"), sum(on, "portChanges")], battles: [sum(off, "battles"), sum(on, "battles")], secessions: [sum(off, "secessions"), sum(on, "secessions")], forms: sum(on, "forms"), breaks: sum(on, "breaks") },
+  seedsWithForm: on.filter((r) => r.forms > 0).length, seedsWithBreak: on.filter((r) => r.breaks > 0).length, seedsWithSecession: on.filter((r) => r.secessions > 0).length, minClaims: Math.min(...on.map((r) => r.claims)), minPortChanges: Math.min(...on.map((r) => r.portChanges)),
+  newWipeouts: on.filter((r) => r.wipeouts.some((f) => !off.find((o) => o.seed === r.seed)!.wipeouts.includes(f))).map((r) => r.seed), causeTot, reasonTot, liveAtEnd: on.reduce((x, r) => x + r.liveAtEnd, 0),
+  durationTicks: allDur.length ? { n: allDur.length, min: allDur[0], median: allDur[Math.floor(allDur.length / 2)], max: allDur[allDur.length - 1] } : null, violations: on.flatMap((r) => r.viol).slice(0, 10), violationCount: on.reduce((x, r) => x + r.viol.length, 0) }, null, 1));
