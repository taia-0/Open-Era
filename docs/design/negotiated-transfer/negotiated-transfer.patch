diff --git a/src/sim/negotiated-transfer.ts b/src/sim/negotiated-transfer.ts
new file mode 100644
index 0000000..513a614
--- /dev/null
+++ b/src/sim/negotiated-transfer.ts
@@ -0,0 +1,176 @@
+import { allied } from "./alliances.ts";
+import { freeMateCount } from "./allowance.ts";
+import { ADJACENT, PRICE_PER_SOLDIER, PURCHASE_CLOCK, RESERVE_PER_HEAD, freeDocked } from "./port-transfer.ts";
+import { atPeace } from "./secession-aftermath.ts";
+import { commandHolderId } from "./state.ts";
+import type { SimEvent, WorldState } from "./types.ts";
+
+/**
+ * NEGOTIATED_TRANSFER (docs/design/negotiated-transfer.md, prototype): a holder offers a port it holds to another
+ * faction; the receiver accepts or declines. Behind the `negotiatedTransfer` run option, default off.
+ * Deterministic: no RNG, no AI. Flag off: nothing here runs and `world.negotiatedTransfer` never exists.
+ */
+export const NEGOTIATED_TRANSFER_DEFAULT = false;
+/** Threat window: alliances.ts ALLIANCE_RAID_WINDOW, p90 of the gap between raids (152, flag off, 13 seeds). */
+export const THREAT_WINDOW = 152;
+/** The surrender line, world-simulation.md:97 (garrison at most 15). Measured: a raided held port at or below it was lost within 152 ticks 330/394 (ATLS) and 511/519 (flag off). */
+export const CESSION_GARRISON = 15;
+/** Shortage clock: p90 of closed below-reserve spells of factions holding ≥ 2 ports, ATLS + fix, 13 seeds × 1,200 (41 ticks, n = 148). */
+export const SHORTAGE_SPELL = 41;
+
+export interface NegotiatedTransferState {
+  /** Last raid on each held port: attacker faction, defender (holder) faction, tick. */
+  raids: Record<string, { by: string; against: string; tick: number }>;
+  /** Faction → first tick of the current below-reserve spell. */
+  shortage: Record<string, number>;
+  /** Declined offers, remembered for the spell (trigger + since) that produced them. */
+  declined: Array<{ settlementId: string; sellerFactionId: string; factionId: string; trigger: string; since: number }>;
+  /** Port → the faction that gave it up by agreement and the tick. No offer back to that faction within THREAT_WINDOW. */
+  returned: Record<string, { from: string; tick: number }>;
+}
+type W = WorldState & { negotiatedTransfer?: NegotiatedTransferState };
+type Emit = (d: { type: string; actorId?: string; settlementId?: string; targetId?: string; data: Record<string, unknown> }) => void;
+
+const ledger = (world: WorldState) => (world as W).negotiatedTransfer;
+const held = (world: WorldState, f: string) => Object.values(world.settlements).filter((s) => s.factionId === f).sort((a, b) => a.id.localeCompare(b.id));
+const dist = (w: WorldState, a: string, b: string) => { const p = w.settlements[a].position, q = w.settlements[b].position; return Math.hypot(p.x - q.x, p.y - q.y); };
+const reserveWith = (world: WorldState, f: string, extraPorts: number) => RESERVE_PER_HEAD * (freeMateCount(world, f) + held(world, f).length + extraPorts);
+const humanHeld = (world: WorldState, f: string) => { const h = commandHolderId(world, f); return h ? world.characters[h]?.controller.kind === "human" : false; };
+
+export const NEGOTIATION_EVENTS = new Set(["transfer-offered", "transfer-declined", "transfer-watch", "transfer-watch-cleared", "transfer-ledger-opened"]);
+
+/** The seller's view of a receiver: what it can see in its own port. Pact partner, then peace partner, then adjacent; docked troops; id. */
+function receivers(world: WorldState, seller: string, portId: string, raider: string | null, taken: Set<string>) {
+  const docked = freeDocked(world, portId);
+  const ids = [...new Set(docked.map((c) => c.factionId!))].filter((f) => f !== seller && f !== raider && world.factions[f] && !taken.has(f));
+  return ids.map((f) => {
+    const pact = allied(world, seller, f);
+    const adj = held(world, f).find((s) => dist(world, s.id, portId) <= ADJACENT);
+    const troops = docked.filter((c) => c.factionId === f).reduce((n, c) => n + c.troops.count, 0);
+    return { factionId: f, pact, peace: atPeace(world, seller, f), adjacent: adj?.id ?? null, troops, agentId: docked.find((c) => c.factionId === f)!.id };
+  }).filter((r) => r.pact || r.adjacent)
+    .sort((a, b) => Number(b.pact) - Number(a.pact) || Number(b.peace) - Number(a.peace) || b.troops - a.troops || a.factionId.localeCompare(b.factionId));
+}
+
+/** Runs every tick with the flag on, right after portPurchases. Offers only on the purchase clock. */
+export function negotiatedTransfers(world: WorldState, emit: Emit, liveSession: boolean): void {
+  if (!ledger(world)) emit({ type: "transfer-ledger-opened", data: {} });
+  const nt = ledger(world)!;
+  // Shortage watch, every tick: treasury below the port-transfer reserve while holding a port.
+  for (const f of Object.keys(world.factions).sort()) {
+    const ports = held(world, f).length;
+    const short = ports > 0 && world.factions[f].treasury < reserveWith(world, f, 0);
+    if (short && nt.shortage[f] === undefined) emit({ type: "transfer-watch", targetId: f, data: { factionId: f, since: world.tick } });
+    else if (!short && nt.shortage[f] !== undefined) emit({ type: "transfer-watch-cleared", targetId: f, data: { factionId: f, since: nt.shortage[f] } });
+  }
+  if (world.tick <= 0 || world.tick % PURCHASE_CLOCK !== 0) return;
+  const taken = new Set<string>();
+  for (const seller of Object.keys(world.factions).sort()) {
+    if (liveSession && humanHeld(world, seller)) continue;
+    // One transfer per faction per clock tick, as seller or as receiver.
+    if (taken.has(seller)) continue;
+    const ports = held(world, seller);
+    if (ports.length < 2) continue;
+    const busy = (id: string) => Object.values(world.activeBattles).some((b) => b.settlementId === id);
+    const tries: Array<{ portId: string; trigger: "cession" | "sale"; since: number; raider: string | null; cause: string }> = [];
+    for (const p of ports) {
+      const r = nt.raids[p.id];
+      if (!r || r.against !== seller || world.tick - r.tick > THREAT_WINDOW || p.garrison > CESSION_GARRISON || busy(p.id)) continue;
+      tries.push({ portId: p.id, trigger: "cession", since: r.tick, raider: r.by, cause: `raided by ${r.by} at tick ${r.tick}; garrison ${p.garrison} ≤ ${CESSION_GARRISON}` });
+    }
+    const since = nt.shortage[seller];
+    if (since !== undefined && world.tick - since >= SHORTAGE_SPELL) {
+      for (const p of [...ports].sort((a, b) => b.garrison - a.garrison || a.id.localeCompare(b.id))) {
+        if (busy(p.id) || tries.some((t) => t.portId === p.id)) continue;
+        const r = nt.raids[p.id];
+        const raider = r && r.against === seller && world.tick - r.tick <= THREAT_WINDOW ? r.by : null;
+        tries.push({ portId: p.id, trigger: "sale", since, raider, cause: `below reserve since tick ${since} (${world.tick - since} ≥ ${SHORTAGE_SPELL})` });
+      }
+    }
+    let done = false;
+    for (const t of tries) {
+      if (done) break;
+      const port = world.settlements[t.portId];
+      for (const r of receivers(world, seller, t.portId, t.raider, taken)) {
+        if (liveSession && humanHeld(world, r.factionId)) continue;
+        const back = nt.returned[t.portId];
+        if (back && back.from === r.factionId && world.tick - back.tick <= THREAT_WINDOW) continue;
+        if (nt.declined.some((d) => d.settlementId === t.portId && d.sellerFactionId === seller && d.factionId === r.factionId && d.trigger === t.trigger && d.since === t.since)) continue;
+        const kind = t.trigger === "cession" && r.pact ? "grant" : "sale";
+        const price = kind === "grant" ? 0 : PRICE_PER_SOLDIER * port.garrison;
+        const offerId = `offer-${world.tick}-${t.portId}-${r.factionId}`;
+        const terms = { offerId, sellerFactionId: seller, factionId: r.factionId, kind, trigger: t.trigger, since: t.since, price,
+          priceBasis: { garrison: port.garrison, perSoldier: kind === "grant" ? 0 : PRICE_PER_SOLDIER }, cause: t.cause,
+          receiverStanding: r.pact ? "pact" : r.peace ? "peace" : "adjacent" };
+        emit({ type: "transfer-offered", settlementId: t.portId, targetId: r.factionId, data: terms });
+        // The receiver's rule: the price plus the reserve with the new seat, from its own treasury.
+        const treasury = world.factions[r.factionId].treasury;
+        const reserve = reserveWith(world, r.factionId, 1);
+        const reason = treasury < reserve ? "reserve" : treasury < price + reserve ? "price" : null;
+        if (reason) {
+          emit({ type: "transfer-declined", settlementId: t.portId, targetId: r.factionId, data: { offerId, sellerFactionId: seller, factionId: r.factionId, trigger: t.trigger, since: t.since, reason } });
+          continue;
+        }
+        emit({ type: "settlement-transferred", actorId: r.agentId, settlementId: t.portId, targetId: r.factionId, data: {
+          ...terms, ownerId: r.agentId, previousOwnerId: port.ownerId, payerFactionId: kind === "sale" ? r.factionId : null, reserve } });
+        taken.add(r.factionId); taken.add(seller);
+        done = true;
+        break;
+      }
+    }
+  }
+}
+
+export function applyNegotiatedTransferEvent(world: WorldState, event: SimEvent): boolean {
+  const w = world as W;
+  switch (event.type) {
+    case "transfer-ledger-opened": w.negotiatedTransfer = { raids: {}, shortage: {}, declined: [], returned: {} }; return true;
+    case "transfer-watch": w.negotiatedTransfer!.shortage[event.data.factionId as string] = event.data.since as number; return true;
+    case "transfer-watch-cleared": {
+      const nt = w.negotiatedTransfer!; const f = event.data.factionId as string;
+      delete nt.shortage[f];
+      nt.declined = nt.declined.filter((d) => !(d.sellerFactionId === f && d.trigger === "sale"));
+      return true;
+    }
+    case "transfer-offered": return true;
+    case "transfer-declined": {
+      const nt = w.negotiatedTransfer!;
+      nt.declined = nt.declined.filter((d) => d.trigger !== "cession" || event.tick - d.since <= THREAT_WINDOW);
+      nt.declined.push({ settlementId: event.settlementId!, sellerFactionId: event.data.sellerFactionId as string, factionId: event.data.factionId as string, trigger: event.data.trigger as string, since: event.data.since as number });
+      return true;
+    }
+    case "settlement-transferred": {
+      const s = world.settlements[event.settlementId!];
+      const price = event.data.price as number;
+      world.factions[event.data.sellerFactionId as string].treasury += price;
+      world.factions[event.data.factionId as string].treasury -= price;
+      s.factionId = event.data.factionId as string; s.ownerId = event.data.ownerId as string; s.surrender = null;
+      if (s.occupation) delete s.occupation;
+      const nt = w.negotiatedTransfer;
+      if (nt) {
+        delete nt.raids[s.id];
+        nt.declined = nt.declined.filter((d) => d.settlementId !== s.id);
+        for (const [id, x] of Object.entries(nt.returned)) if (event.tick - x.tick > THREAT_WINDOW) delete nt.returned[id];
+        nt.returned[s.id] = { from: event.data.sellerFactionId as string, tick: event.tick };
+      }
+      return true;
+    }
+  }
+  return false;
+}
+
+/** Raid ledger per port (flag on only: exists after transfer-ledger-opened). Same raid test as alliances.ts noteRaid. */
+export function noteTransferRaid(world: WorldState, event: SimEvent): void {
+  const nt = ledger(world); if (!nt) return;
+  if (!(event.type === "battle-started" || (event.type === "battle-resolved" && !event.data.battleId))) return;
+  if (!event.settlementId) return;
+  const atk = event.actorId ? world.characters[event.actorId]?.factionId : null; const def = event.targetId;
+  if (atk && def && atk !== def && world.settlements[event.settlementId]?.factionId === def) nt.raids[event.settlementId] = { by: atk, against: def, tick: event.tick };
